  function updateWorld(g, dt, t, view) {
    if (!W.root) return;
    const pcol = (o) => o >= 0 && view.pcol(o) || "#9ff0c0";
    for (const e of W.nodes) {
      const n = e.n, dead = n.amount <= 0;
      if (dead !== e.dead) {
        e.dead = dead;
        e.m.scale.setScalar(dead ? 0.8 : 1);
      }
      if (n.miners && view.visible(n) && inView(n.x, n.y, n.r + 20)) ring4(n.x, n.y, n.r + 10, n.kind === "ice" ? "#8fe3ff" : "#ffb86b", 1.5, { dash: 5, march: true, alpha: 0.4 });
    }
    for (const e of W.nebs) {
      const n = e.n, tt = t * 0.15 + n.x * 0.01;
      e.grp.children.forEach((d, k) => {
        d.position.x = Math.cos(tt + k * 2.1) * n.r * 0.18;
        d.position.z = Math.sin(tt * 1.3 + k * 2.1) * n.r * 0.18;
      });
    }
    const seen = view.vp < 0 ? () => true : view.seen;
    g.sites.forEach((st, i) => {
      let e = W.sites.get(st.id);
      const key = siteKey(st);
      if (!e || e.key !== key) {
        if (e) {
          W.anim.remove(e.m);
        }
        e = { m: siteModel(st, i), key };
        put2(W.anim, e.m, st.x, st.y, 0);
        W.sites.set(st.id, e);
      }
      e.m.visible = seen(st.x, st.y) && inView(st.x, st.y, st.r + 60, 20);
      if (!e.m.visible) return;
      if (st.prog > 0 && !st.done) ring4(st.x, st.y, st.r + 10, pcol(st.by), 3, { a0: -Math.PI / 2, a1: -Math.PI / 2 + TAU14 * st.prog });
      if (st.owner >= 0 && st.kind !== "ruin") ring4(st.x, st.y, st.r + 6, pcol(st.owner), 1.5, { dash: 6, alpha: 0.8 });
    });
    for (const gt of g.gates) {
      let e = W.gates.get(gt.id);
      const col2 = gt.owner >= 0 ? view.pcol(gt.owner) : "", key = gateKey(gt, col2);
      if (!e || e.key !== key) {
        if (e) W.anim.remove(e.m);
        e = { m: gateModel(gt, col2 || void 0), key, charge: -1 };
        put2(W.anim, e.m, gt.x, gt.y, 0);
        W.gates.set(gt.id, e);
      }
      e.m.visible = seen(gt.x, gt.y) && inView(gt.x, gt.y, gt.r + 60, 20);
      if (!e.m.visible) continue;
      if (gt.mode === "lance" && gt.state === "active" && Math.abs((gt.charge || 0) - e.charge) > 5e-3) {
        e.charge = gt.charge || 0;
        setCharge(e.m, e.charge);
      }
      if (gt.prog > 0) ring4(gt.x, gt.y, gt.r + 14, pcol(gt.by), 3, { a0: -Math.PI / 2, a1: -Math.PI / 2 + TAU14 * gt.prog });
    }
    for (const e of W.nodes) e.m.visible = inView(e.n.x, e.n.y, e.n.r * 1.2, e.n.r * 0.5);
    for (const c of W.anim.children) if (c.visible) animate(c, t, dt);
  }
